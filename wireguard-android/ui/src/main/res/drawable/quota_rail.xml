  ~
  ~ The 4dp plan rail. A ProgressBar rather than two nested Views because the fill has to be a
  ~ fraction of a width nothing knows until layout, and the platform already solves that.
  -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="2dp" />
            <solid android:color="@color/rule" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="2dp" />
                <solid android:color="@color/accent" />
            </shape>
        </clip>
    </item>
</layer-list>
