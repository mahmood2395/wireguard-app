  ~
  ~ Nocturne's card material: a flat face and a 1dp hairline. Elevation on a dark ground is an
  ~ edge, not a stack of shadows — which is what the clay material drew, and what forced it to
  ~ pad itself by blur + offset (21dp a side) so the shadow had somewhere to land. That padding
  ~ is why two weighted tiles sat 42dp apart and every screen read as separate floating objects.
  -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/clay_surface_hi" />
    <corners android:radius="8dp" />
    <stroke android:width="1dp" android:color="@color/clay_stroke" />
</shape>
