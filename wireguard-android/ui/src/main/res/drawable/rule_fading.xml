  ~
  ~ Nocturne rules fade out at their ends rather than stopping against nothing. Used as the
  ~ background of a 1dp-high View. Short accent marks (the nav mark) stay solid and do not use this.
  -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="0"
        android:startColor="@android:color/transparent"
        android:centerColor="@color/rule"
        android:endColor="@android:color/transparent"
        android:type="linear" />
</shape>
