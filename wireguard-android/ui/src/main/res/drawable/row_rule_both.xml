  ~
  ~ Bordered top and bottom. Used for the detail screen's Configuration disclosure, which is a
  ~ control rather than one of a run of rows — the second hairline is what closes it off from the
  ~ health rows above and marks it as the last thing on the screen when collapsed.
  -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <item android:gravity="top" android:height="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/rule" />
        </shape>
    </item>
    <item android:gravity="bottom" android:height="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/rule" />
        </shape>
    </item>
</layer-list>
