  ~
  ~ The account card's rail. Its track is the text colour at 14% rather than the page's rule,
  ~ because the card sits on an accent-tinted fill where the rule would disappear.
  -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="2dp" />
            <solid android:color="#24e9e9ed" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="2dp" />
                <solid android:color="@color/accent_400" />
            </shape>
        </clip>
    </item>
</layer-list>
