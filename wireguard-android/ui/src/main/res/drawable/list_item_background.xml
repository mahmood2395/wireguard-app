  ~ Modified by Portway: rows read as inset rounded cards. Resting rows use a surface barely
  ~ lifted off the canvas rather than a strong fill — an earlier pass filled them with
  ~ colorSurfaceVariant and three rows became three featureless slabs.
  -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <item
        android:left="12dp"
        android:right="12dp"
        android:top="4dp"
        android:bottom="4dp">
        <selector>
            <item
                android:state_activated="true"
                app:state_multiselected="true">
                <shape android:shape="rectangle">
                    <solid android:color="?attr/colorSecondaryContainer" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
            <item android:state_activated="true">
                <shape android:shape="rectangle">
                    <solid android:color="?attr/colorSurfaceVariant" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="?attr/rowSurfaceColor" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
        </selector>
    </item>
    <item
        android:left="12dp"
        android:right="12dp"
        android:top="4dp"
        android:bottom="4dp">
        <ripple android:color="?attr/colorControlHighlight">
            <item android:id="@android:id/mask">
                <shape android:shape="rectangle">
                    <solid android:color="#FFFFFFFF" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
        </ripple>
    </item>
</layer-list>
