  ~
  ~ Nocturne's switch: 42x24dp, 12dp radius, a 1dp border always. Off is a transparent fill on a
  ~ #595d6c edge; on is the accent as both fill and edge. Material's own switch draws a filled
  ~ track with a shadowed thumb, which is a different object entirely.
  -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <size android:width="42dp" android:height="24dp" />
            <corners android:radius="12dp" />
            <solid android:color="@color/accent" />
            <stroke android:width="1dp" android:color="@color/accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <size android:width="42dp" android:height="24dp" />
            <corners android:radius="12dp" />
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/switch_off_edge" />
        </shape>
    </item>
</selector>
