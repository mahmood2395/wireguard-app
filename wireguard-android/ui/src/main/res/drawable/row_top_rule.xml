  ~
  ~ Nocturne list rows are not cards. They are separated by a hairline at the top of each row,
  ~ so the list reads as one column rather than a stack of floating objects. Selection paints the
  ~ face; it does not add a second border.
  -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <item android:gravity="top" android:height="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/rule" />
        </shape>
    </item>
</layer-list>
