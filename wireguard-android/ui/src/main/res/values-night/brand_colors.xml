    <!-- The handshake decay bar. #c8a24a is the design's one non-ramp colour and is
         deliberate: an overdue rekey is a warning and the mono accent cannot carry that
         meaning. Teal makes the pair conventional — a green "fresh" against an amber
         "overdue". It appears nowhere else. -->
    <color name="handshake_late">#c8a24a</color>
    <color name="decay_track">#2f313c</color>
    <color name="decay_mark">#6b7183</color>
