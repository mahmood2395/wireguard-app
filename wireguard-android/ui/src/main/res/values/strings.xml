         app does; nothing here is aspirational copy. -->
    <string name="onboard_skip">Skip — I already have a config file</string>
    <string name="onboard_kicker_1">Welcome</string>
    <string name="onboard_title_1">Portway is a door, not a service.</string>
    <string name="onboard_body_1">It carries your traffic to a server you or your provider control. There is no account here and nothing to subscribe to — only the config you were given.</string>
    <string name="onboard_cta_1">Continue</string>
    <string name="onboard_kicker_2">Step 1 of 2</string>
    <string name="onboard_title_2">Add the code your provider sent.</string>
    <string name="onboard_body_2">A QR code or a .conf file. Portway reads it once, keeps the private key on this device, and never sends it anywhere.</string>
    <string name="onboard_cta_2">Scan a QR code</string>
    <string name="onboard_kicker_3">Step 2 of 2</string>
    <string name="onboard_title_3">Android will ask for permission.</string>
    <string name="onboard_body_3">A VPN needs the system\'s consent to route traffic. Android shows its own dialog — Portway cannot skip or fake it.</string>
    <string name="onboard_cta_3">Understood</string>

