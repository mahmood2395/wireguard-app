    <!-- The accent as ONE role, a 100-900 ramp on a shared lightness scale; see DESIGN.md
         for the mix ratios. 600 and 700 have no surface in this build (the design assigns
         them to a second graph series and a throughput sparkline, neither of which exists
         yet) but they stay: a ramp with holes in it is worse than an unused token, and the
         values are not guessable — they must come from the same mixing function as the rest. -->
    <color name="accent">#006a52</color>
    <color name="accent_300">#004434</color>
    <color name="accent_400">#005542</color>
    <color name="accent_600">#008b6d</color>
    <color name="accent_700">#33ac8b</color>
    <color name="accent_800">#96d4be</color>
    <color name="accent_900">#d3efe4</color>
    <color name="rule">#E2E4EC</color>
    <color name="switch_off_edge">#A8ACBC</color>
    <color name="icon_muted">#767A8C</color>
    <!-- The handshake decay bar. The amber keeps #c8a24a's hue and chroma but drops to
         L*45 so it clears 4.9:1 on the light canvas, where the night value manages 2.0:1. -->
    <color name="handshake_late">#856609</color>
    <color name="decay_track">#DDE0EA</color>
    <color name="decay_mark">#767A8C</color>
