<resources>
    <declare-styleable name="Multiselected">
        <attr name="state_multiselected" format="boolean" />
    </declare-styleable>
    <declare-styleable name="TvCardView">
        <attr name="state_isUp" format="boolean" />
        <attr name="state_isDeleting" format="boolean" />
    </declare-styleable>

    <!-- Portway Aurora: resolved in AppThemeBase so a single layout serves both themes.
         Note gradients in <shape> drawables must use @color/aurora_* directly instead —
         ?attr/ only resolves there when the drawable is inflated with a theme. -->
    <attr name="statusConnectingColor" format="color" />
    <attr name="rowSurfaceColor" format="color" />

</resources>
